# Local development database (the OrbStack / Docker Postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/church_reports

# Admin login, applied by `npm run db:admin` (put the real values in .env.local, never here)
ADMIN_NAME=Administrator
ADMIN_USERNAME=choose-a-username
ADMIN_PASSWORD=choose-a-long-password

# Production: copy this file to .env.production.local and use it with
#   npm run db:migrate:prod   and   npm run db:admin:prod
# DATABASE_URL there is the host's DIRECT connection string. In Vercel, set DATABASE_URL to the POOLED one.
